# -----------------------------------------------------------------------------
# OSINT Sentinel Backend - Environment Configuration Template
# -----------------------------------------------------------------------------

# Application
PROJECT_NAME="OSINT Sentinel"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api"

# Server
HOST="0.0.0.0"
PORT=8000

# Database Configuration (PostgreSQL)
# Note: The application starts gracefully even if the database is temporarily unreachable.
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/osint_sentinel"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=True

# Security & CORS
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
